// Cloudflare Workers static-assets config for the storefront site (no server code).
// Deployed with: npx wrangler deploy --config commerce/wrangler.jsonc (token in commerce/.env, never committed).
{
  "name": "commerce-network",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "routes": [
    { "pattern": "mlinjanastudios.com", "custom_domain": true },
    { "pattern": "www.mlinjanastudios.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
