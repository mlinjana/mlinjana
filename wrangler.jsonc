// Cloudflare Workers static-assets config (used when the Worker builds from the repository root).
// Serves the generated storefront site; there is no server code. Name must match the Worker in the dashboard.
{
  "name": "mlinjana",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./commerce/site",
    "not_found_handling": "404-page"
  }
}
